{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092",
    "Topics": [
      "telemetry-flightboxup",
      "telemetry-flightboxdown"
    ],
    "GroupId": "telemetry-mongo-group",
    "StopTimeoutSeconds": 5
  },
  "MongoSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DBName": "TelemetryDB",
    "CollectionName": "DecodedPackets"
  },
  "AllowedHosts": "*"
}