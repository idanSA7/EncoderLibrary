{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092",
    "Topic": "telemetry-flightboxdown",
    "GroupId": "live-telemetry-consumer-group"
  },
  "TelemetryFilterSettings": {
    "IncludedFields": [
      "Speed",
      "Altitude",
      "Temperature"
    ]
  }
}